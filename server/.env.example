# Server
NODE_ENV=development
PORT=3001

# Database (미설정 시 DB 없이 기동)
MONGODB_URI=mongodb://localhost:27017/yameyame

# CORS (쉼표 구분)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# JWT — 자체 세션 토큰 서명 키 (예: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Naver Band OAuth (developers.band.us → My Apps에서 발급)
BAND_CLIENT_ID=
BAND_CLIENT_SECRET=

# 콜백 redirect_uri 구성용 — Band 앱 등록 도메인과 일치해야 함
SERVER_BASE_URL=http://localhost:3001

# 콜백 후 앱 복귀 딥링크
# 프로덕션 빌드: 비워두면 기본값 yameyame://auth 사용
# Expo Go 개발: exp://<LAN IP>:8081/--/auth 로 설정
APP_REDIRECT_URL=
