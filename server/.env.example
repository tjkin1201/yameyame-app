# Server
NODE_ENV=development
PORT=3001

# Database (미설정 시 DB 없이 기동)
MONGODB_URI=mongodb://localhost:27017/yameyame

# CORS (쉼표 구분)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# JWT (Band 연동 시 사용 예정)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Naver Band OAuth (예정)
BAND_CLIENT_ID=
BAND_CLIENT_SECRET=
BAND_REDIRECT_URI=http://localhost:3001/api/auth/band/callback
